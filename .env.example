# Copy to .env and fill in. Never commit .env.

# Model provider: auto (openai if OPENAI_API_KEY is set, else mock) | openai | mock
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
# USD per 1M tokens, used only for the cost estimate shown in traces. Check current pricing.
PRICE_INPUT_PER_M=0.40
PRICE_OUTPUT_PER_M=1.60

# Search provider: ddgs (DuckDuckGo, no key needed) | mock (offline, canned)
SEARCH_PROVIDER=ddgs
SEARCH_MAX_RESULTS=5

# Read the full text of the top N results (0 = use snippets only)
FETCH_PAGES=3
# agentic = the model chooses tool calls in a loop; pipeline = fixed search -> read -> write
RESEARCHER_MODE=agentic
MAX_TOOL_TURNS=4
MAX_SEARCHES=3
MAX_FETCHES=4
# stop the tool loop after this many turns in a row with no new information
MAX_STALE_TURNS=2
# where search/fetch run: local (in-process functions) or mcp (mcp_server.py over MCP)
TOOL_TRANSPORT=local
# optional with TOOL_TRANSPORT=mcp: use a running HTTP MCP server instead of spawning one
# MCP_URL=http://127.0.0.1:8765/mcp
# MCP_TOKEN=choose-a-random-token
PAGE_MAX_CHARS=3000

# Workflow
MAX_REVISIONS=1
FORCE_REJECT_FIRST_REVIEW=false

# Long-term memory (SQLite file)
MEMORY_DB_PATH=memory.db

# Observability (OpenTelemetry): spans + JSON logs in traces/otel, viewed at /traces
TELEMETRY=on
# TELEMETRY_DIR=traces/otel
# Record prompts, answers and tool inputs in spans (off by default: they can hold personal data)
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
# Also export over OTLP/HTTP. Arize Phoenix (local UI, see README "Phoenix"):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=research-assistant
# (Jaeger / an OTel or AWS ADOT collector listen on http://localhost:4318 instead.)
